# IngreDish AI — Backend Environment Variables
# Copy this to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/ingredish

# JWT secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_32_chars

# Server port
PORT=3001

# Frontend origin for CORS (TanStack dev server)
FRONTEND_ORIGIN=http://localhost:3000

# AI API key (Lovable gateway or direct Gemini)
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Lovable AI gateway key (overrides GEMINI_API_KEY if set)
LOVABLE_API_KEY=
